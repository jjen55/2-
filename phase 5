[HQ-EDGE]

enable
configure terminal

interface Serial0/0/0
 description WAN1-PRIMARY-to-BR-R
 ip address 10.0.12.1 255.255.255.252
 clock rate 128000
 no shutdown

interface Serial0/0/1
 description WAN2-BACKUP-to-BR-R
 ip address 10.0.21.1 255.255.255.252
 clock rate 128000
 no shutdown
exit

router ospf 1
 network 10.0.12.0 0.0.0.3 area 0
exit

ip route 10.20.0.0 255.255.0.0 10.0.21.2 250

end
write

[BR-R]

enable
configure terminal

interface Serial0/0/0
 description WAN1-PRIMARY-to-HQ
 ip address 10.0.12.2 255.255.255.252
 no shutdown

interface Serial0/0/1
 description WAN2-BACKUP-to-HQ
 ip address 10.0.21.2 255.255.255.252
 no shutdown
exit

interface GigabitEthernet0/0
 no ip address
 no shutdown

interface GigabitEthernet0/0.110
 description GW-BR-USER
 encapsulation dot1Q 110
 ip address 10.20.10.1 255.255.255.0
 ip helper-address 10.10.50.10
 no shutdown

interface GigabitEthernet0/0.199
 description GW-BR-MGMT
 encapsulation dot1Q 199
 ip address 10.20.99.1 255.255.255.0
 no shutdown

interface GigabitEthernet0/0.999
 encapsulation dot1Q 999 native
 no shutdown
exit

router ospf 1
 router-id 4.4.4.4
 passive-interface GigabitEthernet0/0.110
 passive-interface GigabitEthernet0/0.199
 network 10.0.12.0 0.0.0.3 area 0
 network 10.20.0.0 0.0.255.255 area 0
exit

ip route 0.0.0.0 0.0.0.0 10.0.21.1 250

end
write

[BR-SW]

enable
configure terminal

vtp mode transparent
spanning-tree mode rapid-pvst

vlan 110
 name BR-USER
vlan 199
 name BR-MGMT
vlan 666
 name PARKING
vlan 999
 name NATIVE
exit

interface GigabitEthernet0/1
 description TRUNK-to-BR-R
 switchport mode trunk
 switchport trunk native vlan 999
 switchport trunk allowed vlan 110,199,999
 no shutdown

interface range FastEthernet0/1 - 2
 switchport mode access
 switchport access vlan 110
 spanning-tree portfast
 no shutdown

interface range FastEthernet0/3 - 24 , GigabitEthernet0/2
 switchport mode access
 switchport access vlan 666
 shutdown

interface Vlan199
 ip address 10.20.99.11 255.255.255.0
 no shutdown
exit
ip default-gateway 10.20.99.1

end
write
